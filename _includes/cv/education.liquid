{% comment %}
  Local override of al_folio_cv education entry renderer.
  Date is shown right-aligned and muted on the title row (stacks below on mobile).
  Supports RenderCV (institution/area/studyType|degree/start_date/end_date) and JSONResume fields.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% capture start_date %}{% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}{% endcapture %}
    {% capture end_date %}{% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}{% endcapture %}
    {% assign start_date = start_date | strip %}
    {% assign end_date = end_date | strip %}
    {% if start_date != '' and end_date != '' %}
      {% assign date_range = start_date | append: ' – ' | append: end_date %}
    {% elsif start_date != '' %}
      {% assign date_range = start_date | append: ' – Present' %}
    {% elsif end_date != '' %}
      {% assign date_range = end_date %}
    {% else %}
      {% assign date_range = '' %}
    {% endif %}

    <li class="list-group-item">
      <div class="d-flex flex-column flex-md-row justify-content-between">
        <div class="flex-grow-1">
          {% capture study_type %}{% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}{% endcapture %}
          {% if entry.url %}
            <h6 class="title font-weight-bold mb-0">
              <a href="{{ entry.url }}">{{ study_type | strip }}</a>
            </h6>
          {% elsif study_type != '' %}
            <h6 class="title font-weight-bold mb-0">{{ study_type | strip }}</h6>
          {% endif %}

          {% if entry.institution %}
            <h6 class="mb-0" style="font-size: 0.95rem">{{ entry.institution }}</h6>
          {% endif %}

          {% if entry.area %}
            <h6 class="mb-0" style="font-size: 0.95rem; font-style: italic">{{ entry.area }}</h6>
          {% endif %}
        </div>

        {% if date_range != '' or entry.location %}
          <div class="text-right mt-1 mt-md-0 ml-md-4" style="white-space: nowrap; opacity: 0.7; font-size: 0.9rem">
            {% if date_range != '' %}
              <div>{{ date_range }}</div>
            {% endif %}
            {% if entry.location %}
              <div style="font-size: 0.8rem">{{ entry.location }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if entry.courses or entry.highlights %}
        <ul class="items">
          {% for item in entry.courses %}
            <li>
              <span class="item">{{ item }}</span>
            </li>
          {% endfor %}
          {% for item in entry.highlights %}
            <li>
              <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
