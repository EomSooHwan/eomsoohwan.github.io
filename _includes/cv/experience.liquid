{% comment %}
  Local override of al_folio_cv experience entry renderer.
  Date is shown right-aligned and muted on the title row (stacks below on mobile).
  Supports RenderCV (company/position/start_date/end_date) and JSONResume (name/startDate/endDate) fields.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% capture start_date %}{% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}{% endcapture %}
    {% capture end_date %}{% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}{% endcapture %}
    {% assign start_date = start_date | strip %}
    {% assign end_date = end_date | strip %}
    {% if start_date != '' and end_date != '' %}
      {% assign date_range = start_date | append: ' – ' | append: end_date %}
    {% elsif start_date != '' %}
      {% assign date_range = start_date | append: ' – Present' %}
    {% else %}
      {% assign date_range = '' %}
    {% endif %}

    <li class="list-group-item">
      <div class="d-flex flex-column flex-md-row justify-content-between">
        <div class="flex-grow-1">
          {% capture position_title %}{% if entry.position %}{{ entry.position }}{% endif %}{% endcapture %}
          {% if entry.url %}
            <h6 class="title font-weight-bold mb-0">
              <a href="{{ entry.url }}">{{ position_title | strip }}</a>
            </h6>
          {% elsif position_title != '' %}
            <h6 class="title font-weight-bold mb-0">{{ position_title | strip }}</h6>
          {% endif %}

          {% capture company_name %}{% if entry.name %}{{ entry.name }}{% elsif entry.company %}{{ entry.company }}{% elsif entry.organization %}{{ entry.organization }}{% endif %}{% endcapture %}
          {% if company_name != '' %}
            <h6 class="mb-0" style="font-size: 0.95rem">{{ company_name | strip }}</h6>
          {% endif %}

          {% if entry.summary %}
            <h6 class="mb-0" style="font-size: 0.95rem; font-style: italic">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</h6>
          {% endif %}
        </div>

        {% if date_range != '' %}
          <div class="text-right mt-1 mt-md-0 ml-md-4" style="white-space: nowrap; opacity: 0.7; font-size: 0.9rem">{{ date_range }}</div>
        {% endif %}
      </div>

      {% if entry.highlights %}
        <ul class="items">
          {% for item in entry.highlights %}
            <li>
              <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
